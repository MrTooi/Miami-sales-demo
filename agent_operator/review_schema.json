{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "needs-human"]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["blocking", "important", "minor"]
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": ["severity", "title", "evidence"]
      }
    }
  },
  "required": ["verdict", "summary", "findings"]
}
