{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite", "results"],
  "properties": {
    "suite": {"type": "string", "enum": ["a", "b", "c"]},
    "results": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "primary", "reviewers", "must_do_met", "must_not_violated"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "primary": {"type": "string", "minLength": 1},
          "reviewers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "must_do_met": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {"type": "boolean"}
          },
          "must_not_violated": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {"type": "boolean"}
          }
        }
      }
    }
  }
}
