{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite", "cases"],
  "properties": {
    "suite": {"type": "string", "enum": ["a", "b", "c"]},
    "cases": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "primary", "reviewers", "risk", "proposed_action",
          "verification_plan", "approval_requirements", "uncertainty", "refusals"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "primary": {"type": "string", "minLength": 1},
          "reviewers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "risk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "proposed_action": {"type": "string", "minLength": 1},
          "verification_plan": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1}
          },
          "approval_requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1}
          },
          "uncertainty": {"type": "string", "minLength": 1},
          "refusals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
